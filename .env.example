# ---------------------------------------------------------------------------
# Sorrel restaurant starter — environment variables
#
# Leave EVERYTHING empty to run in Demo Mode: the full website and a demo
# dashboard work with sample data, and no order is ever sent anywhere.
#
# Fill in the three Supabase values to switch to Production Mode (real menu,
# real orders, secure staff login). Rebuild/redeploy after changing them —
# NEXT_PUBLIC_* values are baked in at build time.
# ---------------------------------------------------------------------------

# Your public website address, used for social sharing previews.
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (sb_secret_…), or the legacy "service_role" key.
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ and never share it.
SUPABASE_SECRET_KEY=

# Optional: any long random string. Used to anonymise customer IP addresses
# for order rate limiting. Defaults to a value derived from the secret key.
ORDER_IP_SALT=

# Server only. Which proxy in front of the app may tell us the visitor's IP
# address, for the per-connection order limit:
#   hostinger  Hostinger Node.js hosting (Hostinger CDN in front of the app)
#   1, 2 …     that many proxies you run yourself, each appending X-Forwarded-For
#   (empty)    trust no header: the per-connection limit is off, the site-wide
#              limit and duplicate-order protection still apply.
# After deploying, check it at /admin/connection-check (see README).
TRUSTED_PROXY=

# Optional: set to "true" to force Demo Mode even when Supabase is configured.
NEXT_PUBLIC_FORCE_DEMO=
